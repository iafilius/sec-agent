{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sec-agent Operations Flight Log Entry",
  "type": "object",
  "required": [
    "timestamp",
    "actor",
    "action",
    "profile",
    "master_key_sha256",
    "details",
    "success"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 UTC timestamp when operation was logged"
    },
    "actor": {
      "type": "string",
      "description": "Origin of the operation (e.g. terminal, ai-agent, web-ui)"
    },
    "action": {
      "type": "string",
      "description": "Operation action type (e.g. SNAPSHOT_CREATE, SNAPSHOT_RESTORE, MIGRATE_V2, SET_SECRET)"
    },
    "profile": {
      "type": "string",
      "description": "Target profile vault name"
    },
    "master_key_sha256": {
      "type": "string",
      "description": "Active master key SHA-256 fingerprint (sha256:16hex)"
    },
    "details": {
      "type": "string",
      "description": "Human-readable operation summary or parameters"
    },
    "success": {
      "type": "boolean",
      "description": "Result status of the operation"
    },
    "error": {
      "type": "string",
      "description": "Error description if operation failed"
    }
  }
}
